# Copy this file to .env.local and fill in the values.
# Supabase dashboard → click "Connect" (URL + publishable key) and
# Project Settings → API Keys (secret key).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only secret key — used ONLY by the submit API after it validates a response.
# Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Public URL of the app (email links; fallback for the embed snippet).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: slug of one of your PUBLISHED forms. When set, the landing page embeds
# the real widget (bottom-right bubble) so visitors can try it end to end.
# NEXT_PUBLIC_DEMO_FORM_SLUG=
